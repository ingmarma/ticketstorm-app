          },
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"ai-discovery\",uri=~\"/api/v1/chat.*\"}[2m])) / sum(rate(http_server_requests_seconds_count{job=\"ai-discovery\",uri=~\"/api/v1/chat.*\"}[2m])) or vector(0)",

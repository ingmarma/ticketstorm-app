# ============================================================
# TicketStorm — .gitignore
# ============================================================

# ---- Java / Maven ----
target/
*.class
*.jar
*.war
*.ear
*.nar
dependency-reduced-pom.xml
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
hs_err_pid*
replay_pid*

# ---- Gradle ----
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# ---- Node.js ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
*.tsbuildinfo
.nyc_output/
coverage/

# ---- Docker ----
docker-compose.override.yml

# ---- Terraform ----
terraform/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.*
terraform/**/*.tfplan
terraform/**/.terraform.lock.hcl
terraform/**/crash.log
terraform/**/crash.*.log
terraform/**/*-.tf
terraform/**/*-.tf.json
terraform/**/override.tf
terraform/**/override.tf.json
terraform/**/*.auto.tfvars
terraform/**/terraform.rc
terraform/**/credentials.tfrc.json

# ---- Kubernetes secrets (never commit) ----
k8s/**/secrets/
k8s/**/secret*.yml
k8s/**/secret*.yaml
*.secret

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
.factorypath
*.iml
*.ipr
*.iws
out/
*.o
*.obj
*.so

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
*.log

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
*.whl
.venv/
venv/
env/
.Python

# ---- Environment / Secrets ----
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa*
*.jks
*.p12

# ---- Build artifacts ----
*.tar.gz
*.zip
*.tar
dist/
build/

# ---- Misc ----
*.bak
*.orig
*.rej
coverage.xml
htmlcov/
.pytest_cache/
.tox/
.nox/
